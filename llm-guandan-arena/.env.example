# Drop keys in later. With every key empty, the arena plays four Mock seats.

# DeepSeek — seat 0 / North, display name "DeepSeek V4.1 Flash"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4.1-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini — seat 1 / East, display name "Gemini 3.8 Flash"
# Either variable is enough.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Xiaomi MiMo — seat 2 / South, display name "MiMo 2.6 Flash"
# OpenAI-compatible base. Pay-as-you-go default is below; Token Plan users
# should replace it with the console base URL.
MIMO_API_KEY=
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.6-flash

# Zhipu GLM — seat 3 / West, display name "GLM 5.3 Flash"
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-5.3-flash
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# Jev / TypeSafe assist. Optional heuristic. The engine still checks legality.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest

# Optional. Unset = this Node process only. Set = rooms and matches are shared.
# REDIS_URL=redis://127.0.0.1:6379
# TENANT_MAX_ROOMS=40
# Failed 打A attempts before that side drops to 2. 0 stays on A.
# GUANDAN_ACE_STRIKES=3
# Sliding expiry for room and match keys, in seconds. Each save refreshes it. 0 disables.
# GUANDAN_ROOM_TTL_SEC=21600
# Consecutive timeouts before a self seat is switched to Mock. Unset or 0 never kicks.
# The seat token stays valid either way.
# GUANDAN_KICK_AFTER=0
